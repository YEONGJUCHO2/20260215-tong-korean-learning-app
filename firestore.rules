rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read for posts, but restrict write to authenticated users
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default rule: restrict everything else to authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}